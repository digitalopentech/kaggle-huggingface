# Copie este arquivo para .env e preencha com suas credenciais.
# O .env é carregado automaticamente pelo activate.sh e pelos scripts (python-dotenv).

# ── Hugging Face ────────────────────────────────────────────────
# Crie um token em: https://huggingface.co/settings/tokens
# (tipo "Read" basta para baixar modelos/datasets; "Write" para publicar)
HF_TOKEN=

# Opcional: onde o HF guarda cache de modelos/datasets (padrão: ~/.cache/huggingface)
# HF_HOME=/Users/leonardonunes/.cache/huggingface

# ── Kaggle ──────────────────────────────────────────────────────
# Crie em: https://www.kaggle.com/settings -> API -> "Create New Token"
# Formato novo (recomendado): um token único que começa com KGAT_
KAGGLE_API_TOKEN=

# Formato antigo (kaggle.json com username + key) — alternativa:
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# ── Twilio (envio de SMS) ───────────────────────────────────────
# Credenciais em: https://console.twilio.com (painel inicial)
# O FROM_NUMBER é o número que a Twilio te dá (formato E.164: +1...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
